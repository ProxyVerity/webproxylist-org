---
const UNKNOWN = 'Not stated by the provider';

interface Props {
  slug: string;
  name: string;
  domain: string;
  summary: string;
  category: string;
  protocols: string[];
  countries: string[];
  pricingFrom: string;
  pricingUnit: string;
  locationsClaimed?: string;
  logo?: string;
}
const {
  slug, name, domain, summary, category, protocols, countries,
  pricingFrom, pricingUnit, locationsClaimed, logo,
} = Astro.props;

const protocolsKnown = !(protocols.length === 1 && protocols[0] === UNKNOWN);
const coverage = locationsClaimed ?? `${countries.length} countries`;
const monogram = name.replace(/[^A-Za-z0-9]/g, '').charAt(0).toUpperCase();
---

<li class="row">
  <div class="row__id">
    {
      logo ? (
        <img class="row__mark" src={logo} alt="" width="34" height="34" loading="lazy" />
      ) : (
        <span class="row__mark" aria-hidden="true">{monogram}</span>
      )
    }
    <div>
      <h2 class="row__name"><a href={`/${slug}/`}>{name}</a></h2>
      <div class="row__domain">{domain}</div>
    </div>
  </div>

  <p class="row__summary">{summary}</p>

  <div class="row__specs">
    <div><b>{category}</b></div>
    <div>
      {protocolsKnown ? protocols.join(' · ') : <span class="na">protocols not stated</span>}
    </div>
    <div>{coverage}</div>
  </div>

  <div class="row__price">
    <span class="amount">{pricingFrom}</span>
    <span class="unit">{pricingUnit}</span>
  </div>
</li>
