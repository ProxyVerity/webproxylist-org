---
interface Props {
  rows: Array<[string, string]>;
}
const { rows } = Astro.props;
---

<div class="table-wrap">
  <table class="specs">
    <tbody>
      {
        rows.map(([label, value]) => (
          <tr>
            <th scope="row">{label}</th>
            <td>{value}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
