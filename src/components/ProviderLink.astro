---
/**
 * The only component that renders an outbound link to a provider.
 *
 * Nothing else in this project writes a rel attribute on an external link, so
 * the value cannot drift from page to page. Which of the two values applies is
 * decided by the entry's kind, not by the page that happens to render it.
 */
import { OUTBOUND_REL_EXCHANGE, OUTBOUND_REL_LISTING } from '../lib/rel';

interface Props {
  href: string;
  kind: 'exchange' | 'listing';
  class?: string;
}
const { href, kind, class: className } = Astro.props;
const rel = kind === 'exchange' ? OUTBOUND_REL_EXCHANGE : OUTBOUND_REL_LISTING;
---

<a href={href} rel={rel} class={className}><slot /></a>
