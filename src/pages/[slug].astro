---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProviderLink from '../components/ProviderLink.astro';

const UNKNOWN = 'Not stated by the provider';

export async function getStaticPaths() {
  const providers = await getCollection('providers');
  return providers.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const monogram = d.name.replace(/[^A-Za-z0-9]/g, '').charAt(0).toUpperCase();
const protocolsKnown = !(d.protocols.length === 1 && d.protocols[0] === UNKNOWN);

const specs: Array<[string, string, boolean]> = [
  ['Category', d.category, false],
  ['Protocols', protocolsKnown ? d.protocols.join(', ') : UNKNOWN, !protocolsKnown],
  ['Coverage', d.locations_claimed ?? `${d.countries.length} countries`, false],
  ['Targeting', d.countries.join(', '), false],
  ['Rotation', d.rotation, /not stated/i.test(d.rotation)],
  ['API', d.api ? 'Yes' : 'Not documented', !d.api],
  ['Pricing from', `${d.pricing_from} ${d.pricing_unit}`, false],
  ['Entry updated', d.updated.toISOString().slice(0, 10), false],
];
---

<Base
  title={`${d.name} — ${d.category} | webproxylist.org`}
  description={d.summary}
  canonicalPath={`/${entry.id}/`}
>
  <div class="wrap ph">
    <div class="ph__top">
      {
        d.logo ? (
          <img class="ph__mark" src={d.logo} alt="" width="52" height="52" />
        ) : (
          <span class="ph__mark" aria-hidden="true">{monogram}</span>
        )
      }
      <div>
        <h1>{d.name}</h1>
        <div class="ph__domain">{d.domain}</div>
      </div>
    </div>

    <p class="ph__summary">{d.summary}</p>
    <ProviderLink href={d.url} kind={d.kind} class="cta">Visit {d.domain}</ProviderLink>

    <dl class="specs">
      {
        specs.map(([term, value, absent]) => (
          <div class="specs__row">
            <dt>{term}</dt>
            <dd class={absent ? 'na' : undefined}>{value}</dd>
          </div>
        ))
      }
    </dl>

    {
      d.screenshot && (
        <figure class="shot">
          <img
            src={d.screenshot}
            alt={`Home page of ${d.domain}`}
            loading="lazy"
            width="1280"
            height="800"
          />
          <figcaption>{d.domain} home page</figcaption>
        </figure>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <div class="disclosure">
      <p>
        <strong>Disclosure.</strong> webproxylist.org is operated by the team behind
        ProxyVerity. This directory does not rank providers, and inclusion is not an
        endorsement — see <a href="/about/">About</a>.
      </p>
      <p>Pricing and coverage come from the provider and change without notice.</p>
    </div>

    <p class="backlink"><a href="/">&larr; All providers</a></p>
  </div>
</Base>
