---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProviderRow from '../components/ProviderRow.astro';

const providers = (await getCollection('providers')).sort(
  (a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name),
);
---

<Base
  title="webproxylist.org — proxy provider directory"
  description="A directory of commercial proxy providers: protocols, coverage, rotation, pricing and what each service is built for."
  canonicalPath="/"
>
  <div class="wrap intro">
    <h1>Proxy provider directory</h1>
    <p>
      One page per provider: which protocols they speak, how much of the world they cover, how
      rotation works, what the entry price buys, and where their own published figures
      contradict each other. Entries are not ranked.
    </p>
  </div>

  <div class="wrap">
    <ul class="list">
      {
        providers.map((p) => (
          <ProviderRow
            slug={p.id}
            name={p.data.name}
            domain={p.data.domain}
            summary={p.data.summary}
            category={p.data.category}
            protocols={p.data.protocols}
            countries={p.data.countries}
            pricingFrom={p.data.pricing_from}
            pricingUnit={p.data.pricing_unit}
            locationsClaimed={p.data.locations_claimed}
            logo={p.data.logo}
          />
        ))
      }
    </ul>
  </div>
</Base>
